# Local development only. `make bootstrap` copies this to .env and generates
# the two application secrets below. Never commit the resulting .env file.
SERVER_HOST=0.0.0.0
SERVER_PUBLIC=127.0.0.1
SERVER_PORT=8000

MYSQL_HOST=127.0.0.1
MYSQL_PORT=13306
MYSQL_DATABASE=ai_nexus
MYSQL_USER=ainexus
MYSQL_PASSWORD=change-me
MYSQL_ROOT_PASSWORD=change-me-root

REDIS_ADDR=127.0.0.1:6379
REDIS_PASSWORD=change-me-redis
REDIS_DB=0

RABBITMQ_HOST=127.0.0.1
RABBITMQ_PORT=5672
RABBITMQ_USER=ainexus
RABBITMQ_PASSWORD=change-me-rabbitmq
RABBITMQ_VHOST=/ainexus

# Mail Service. Plaintext gRPC is only appropriate for local development.
MAIL_GRPC_ADDRESS=127.0.0.1:8080
MAIL_GRPC_TIMEOUT=3s
MAIL_GRPC_ALLOW_INSECURE=true
MAIL_GRPC_TLS_CA_FILE=
MAIL_GRPC_TLS_SERVER_NAME=
MAIL_CALLBACK_ADDRESS=:8081
MAIL_CALLBACK_ALLOW_INSECURE=true
MAIL_CALLBACK_TLS_CERT_FILE=
MAIL_CALLBACK_TLS_KEY_FILE=
MAIL_SENDER_IDENTITY_KEY=ainexus.default
MAIL_LOCALE=zh-CN
MAIL_VERIFICATION_TTL=5m
MAIL_DISPATCH_DEADLINE=2m
MAIL_PENDING_TTL=15m
MAIL_VERIFICATION_COOLDOWN=60s
MAIL_VERIFICATION_MAX_ATTEMPTS=5
MAIL_RECONCILE_INTERVAL=30s

# Generated by `make bootstrap`; do not reuse in deployed environments.
JWT_SECRET=replace-with-a-random-secret
CHAT_ENCRYPTION_KEY=replace-with-a-64-character-hex-key
VERIFICATION_HMAC_SECRET=replace-with-a-random-secret
VERIFICATION_EMAIL_FINGERPRINT_SECRET=replace-with-a-random-secret

# Optional. Required only when exercising ModelScope image-generation workers.
MODELSCOPE_API_KEY=
